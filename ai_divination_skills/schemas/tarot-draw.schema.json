{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sapuyou45-bit.github.io/ai-divination-skills/schemas/tarot-draw.schema.json",
  "title": "Tarot Draw",
  "type": "object",
  "required": [
    "system",
    "deck",
    "spread",
    "deck_size",
    "draw_count",
    "drawn_indices",
    "shuffle_algorithm",
    "rng_mode",
    "randomness",
    "reversals_enabled",
    "cards"
  ],
  "properties": {
    "system": {"const": "tarot"},
    "deck": {"enum": ["major", "full"]},
    "spread": {"enum": ["single", "three-card", "decision", "creative", "project"]},
    "deck_size": {"type": "integer", "enum": [22, 78]},
    "draw_count": {"type": "integer", "minimum": 1},
    "drawn_indices": {
      "type": "array",
      "items": {"type": "integer", "minimum": 0}
    },
    "shuffle_algorithm": {"const": "fisher-yates"},
    "rng_mode": {"enum": ["seeded-demo", "system"]},
    "randomness": {"enum": ["seeded", "system"]},
    "reversals_enabled": {"type": "boolean"},
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["position", "name", "index", "arcana", "suit", "reversed", "orientation"],
        "properties": {
          "position": {"type": "string"},
          "name": {"type": "string"},
          "index": {"type": "integer", "minimum": 0},
          "arcana": {"enum": ["major", "minor"]},
          "suit": {"type": "string"},
          "reversed": {"type": "boolean"},
          "orientation": {"enum": ["upright", "reversed"]}
        }
      }
    }
  }
}
